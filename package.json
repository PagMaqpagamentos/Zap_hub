{
  "name": "zap-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
